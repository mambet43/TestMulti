<?xml version="1.0" encoding="UTF-8" ?>

<Shell    
    x:Class="TestMulti.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TestMulti"
    xmlns:view="clr-namespace:TestMulti.Views"
    Shell.FlyoutBehavior="Flyout"
    Shell.FlyoutWidth="270"
    FlyoutBackgroundColor="{StaticResource BackColorC}"
    BackgroundColor="{StaticResource BackColorB}"   
    Title="TestMulti">
    <ShellContent
        Title="Главная"  
        Icon="home.png"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage"/>
    

</Shell>
