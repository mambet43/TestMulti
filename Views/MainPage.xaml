<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:TestMulti.Models"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    x:Class="TestMulti.MainPage"
    BackgroundColor="{StaticResource BackColorB}">
    <ContentPage.Resources>
        

        <Style x:Key="ActionLabel" TargetType="Label">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalTextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

       
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Добавить новую тему" Order="Secondary" Priority="0" Command="{Binding AddThemeCommand}"/>
        <ToolbarItem Text="Удалить эту тему" Order="Secondary" Priority="1" Command="{Binding DelThemeCommand}"/>
        <ToolbarItem Text="Поделиться темой" Order="Secondary" Priority="2" Command="{Binding ShareThemeCommand}"/>
    </ContentPage.ToolbarItems>
    
        <FlexLayout Padding="10">
        <Label Text="{Binding TextEmptyTheme}" HorizontalOptions="Center"  FontSize="16" FontAttributes="Bold" />
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
          Command="{Binding RefreshCommand}">        
            <Grid RowDefinitions="*,Auto">
                <CarouselView x:Name="CarouselMain" 
                Position="{Binding CurrentPosition}"
                 ItemsSource="{Binding Themes}"
                CurrentItemChangedCommand="{Binding CurrentItemChangedCommand}"
                IndicatorView="indicator"   
                Loop="False"
                Margin="10"                
                HorizontalScrollBarVisibility="Never"
                VerticalOptions="Start"
                HorizontalOptions="Start"
                Grid.Row="0">
                    <CarouselView.ItemTemplate>
                        <DataTemplate x:DataType="models:Theme">
                            <Frame    
                                HorizontalOptions="Center"
                                CornerRadius="28" 
                                BackgroundColor="{StaticResource BackColorA}"                            
                                BorderColor="White">


                                <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center" JustifyContent="Center">
                                    <lvc:PieChart 
                                        Series="{Binding Series}" 
                                        Title="{Binding PieTitle}" 
                                        HeightRequest="400"
                                        WidthRequest="400"
                                        InitialRotation="90" 
                                        MaxAngle="270 " 
                                        MinValue="0" 
                                        MaxValue="{Binding LengthQ}" 
                                        AnimationsSpeed="00:00:01.500"/>

                                    <StackLayout Spacing="5">
                                        <!-- Все строки с иконками и TapGestureRecognizer -->
                                        <Grid ColumnDefinitions="48,*" VerticalOptions="Center">
                                            <Image Source="all.png" HeightRequest="48" WidthRequest="48"/>
                                            <Label Grid.Column="1" Style="{StaticResource ActionLabel}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ActionClickedCommand}" CommandParameter="Start"/>
                                                </Label.GestureRecognizers>
                                                <Label.Text>
                                                    <Binding Path="LengthQ" StringFormat="[{0}] Все вопросы"/>
                                                </Label.Text>
                                            </Label>
                                        </Grid>

                                        <Grid ColumnDefinitions="48,*" VerticalOptions="Center">
                                            <Image Source="play.png" HeightRequest="48" WidthRequest="48"/>
                                            <Label Grid.Column="1" Style="{StaticResource ActionLabel}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ActionClickedCommand}" CommandParameter="Replay"/>
                                                </Label.GestureRecognizers>
                                                <Label.Text>
                                                    <Binding Path="LengthReplay" StringFormat="[{0}] Продолжить"/>
                                                </Label.Text>
                                            </Label>
                                        </Grid>

                                        <Grid ColumnDefinitions="48,*" VerticalOptions="Center">
                                            <Image Source="vaworites.png" HeightRequest="48" WidthRequest="48"/>
                                            <Label Grid.Column="1" Style="{StaticResource ActionLabel}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ActionClickedCommand}" CommandParameter="Vaworite"/>
                                                </Label.GestureRecognizers>
                                                <Label.Text>
                                                    <Binding Path="LengthVaworite" StringFormat="[{0}] Избранные вопросы"/>
                                                </Label.Text>
                                            </Label>
                                        </Grid>

                                        <Grid ColumnDefinitions="48,*" VerticalOptions="Center">
                                            <Image Source="retryerr.png" HeightRequest="48" WidthRequest="48"/>
                                            <Label Grid.Column="1" Style="{StaticResource ActionLabel}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ActionClickedCommand}" CommandParameter="Error"/>
                                                </Label.GestureRecognizers>
                                                <Label.Text>
                                                    <Binding Path="LengthErr" StringFormat="[{0}] Мои ошибки"/>
                                                </Label.Text>
                                            </Label>
                                        </Grid>

                                        <Grid ColumnDefinitions="48,*" VerticalOptions="Center">
                                            <Image Source="retrylong.png" HeightRequest="48" WidthRequest="48"/>
                                            <Label Grid.Column="1" Style="{StaticResource ActionLabel}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ActionClickedCommand}" CommandParameter="Long"/>
                                                </Label.GestureRecognizers>
                                                <Label.Text>
                                                    <Binding Path="LengthLong" StringFormat="[{0}] Долгие ответы"/>
                                                </Label.Text>
                                            </Label>
                                        </Grid>

                                        <Grid ColumnDefinitions="48,*" VerticalOptions="Center">
                                            <Image Source="del.png" HeightRequest="48" WidthRequest="48"/>
                                            <Label Grid.Column="1" Style="{StaticResource ActionLabel}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding DelPreferencesCommand}" 
                                         CommandParameter="{Binding FileName}"/>
                                                </Label.GestureRecognizers>
                                                <Label.Text>Удалить результаты</Label.Text>
                                            </Label>
                                        </Grid>
                                    </StackLayout>
                                </FlexLayout>
                            </Frame>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>

                <IndicatorView
                x:Name="indicator"
                Margin="0"
                Grid.Row="1"
                IndicatorColor="{StaticResource Primary}"
                SelectedIndicatorColor="Blue"            
                IndicatorsShape="Square"
                HorizontalOptions="Center"
                IndicatorSize="10"/>
            </Grid>
        </RefreshView>
    </FlexLayout>
  
</ContentPage>