<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="TestMulti.MainPage"
             BackgroundColor="{StaticResource BackColorB}">
    <ScrollView>
        <FlexLayout Direction="Row" 
                   Wrap="Wrap" 
                   JustifyContent="SpaceEvenly" 
                   AlignItems="Stretch"
                   Padding="10">

            <!-- Электробезопасность -->
            <Frame CornerRadius="18" 
                   BackgroundColor="{StaticResource BackColorA}"
                   Margin="5"
                   Padding="5"
                   HorizontalOptions="FillAndExpand"
                   FlexLayout.Basis="350"
                   FlexLayout.Grow="1">
                <StackLayout Spacing="10">
                    <Label Text="Электробезопасность" 
                           FontSize="18" 
                           HorizontalOptions="Center" 
                           Margin="0,0,0,10" />

                    <lvc:PieChart Series="{Binding Series}"
                                 HeightRequest="250"
                                 InitialRotation="90"  
                                 MaxAngle="270"
                                 MinValue="0"
                                 MaxValue="100"
                                 AnimationsSpeed="00:00:05.500"                      
                                 PressedCommand="{Binding PressedCommand}">
                    </lvc:PieChart>

                    <StackLayout Spacing="5" HorizontalOptions="Start">
                        <Button Text="Повторить" 
                               FontSize="18" 
                               BackgroundColor="Transparent"
                               HorizontalOptions="Start"
                               ImageSource="retryall.png">
                        </Button>

                        <Button Text="Мои ошибки" 
                                ImageSource="retryerr.png"
                               FontSize="18" 
                               BackgroundColor="Transparent"
                               HorizontalOptions="Start">
                        </Button>

                        <Button Text="Избранные вопросы" 
                                ImageSource="vaworites.png"
                               FontSize="18" 
                               BackgroundColor="Transparent"
                               HorizontalOptions="Start">
                        </Button>

                        <Button Text="Долгие ответы" 
                                ImageSource="retrylong.png"
                               FontSize="18" 
                               BackgroundColor="Transparent"
                               HorizontalOptions="Start">
                        </Button>

                        <Button Text="Удалить результаты" 
                                ImageSource="del.png"
                               FontSize="18" 
                               BackgroundColor="Transparent"
                               Clicked="clearbtn_Clicked"
                               HorizontalOptions="Start">
                        </Button>
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- Охрана труда -->
            <Frame CornerRadius="18" 
       BackgroundColor="{StaticResource BackColorA}"
       Margin="5"
       HorizontalOptions="FillAndExpand"
       FlexLayout.Basis="350"
       FlexLayout.Grow="1">
                <StackLayout Spacing="10">
                    <Label Text="Охрана труда" 
               FontSize="18" 
               HorizontalOptions="Center" 
               Margin="0,0,0,10" />

                    <lvc:PieChart Series="{Binding Series}"
                     HeightRequest="250"
                     InitialRotation="90"  
                     MaxAngle="270"
                     MinValue="0"
                     MaxValue="100"
                     AnimationsSpeed="00:00:05.500"                      
                     PressedCommand="{Binding PressedCommand}">
                    </lvc:PieChart>

                    <StackLayout Spacing="5" HorizontalOptions="Start">
                        <Button Text="Повторить" 
                   FontSize="18" 
                   BackgroundColor="Transparent"
                   HorizontalOptions="Start"
                   ImageSource="retryall.png">
                        </Button>

                        <Button Text="Мои ошибки" 
                    ImageSource="retryerr.png"
                   FontSize="18" 
                   BackgroundColor="Transparent"
                   HorizontalOptions="Start">
                        </Button>

                        <Button Text="Избранные вопросы" 
                    ImageSource="vaworites.png"
                   FontSize="18" 
                   BackgroundColor="Transparent"
                   HorizontalOptions="Start">
                        </Button>

                        <Button Text="Долгие ответы" 
                    ImageSource="retrylong.png"
                   FontSize="18" 
                   BackgroundColor="Transparent"
                   HorizontalOptions="Start">
                        </Button>

                        <Button Text="Удалить результаты" 
                    ImageSource="del.png"
                   FontSize="18" 
                   BackgroundColor="Transparent"
                   Clicked="clearbtn_Clicked"
                   HorizontalOptions="Start">
                        </Button>
                    </StackLayout>
                </StackLayout>
            </Frame>
            <!-- Работы на высоте -->
            <Frame CornerRadius="18" 
       BackgroundColor="{StaticResource BackColorA}"
       Margin="5"
       HorizontalOptions="FillAndExpand"
       FlexLayout.Basis="350"
       FlexLayout.Grow="1">
                <StackLayout Spacing="10">
                    <Label Text="Работы на высоте" 
               FontSize="18" 
               HorizontalOptions="Center" 
               Margin="0,0,0,10" />

                    <lvc:PieChart Series="{Binding Series}"
                     HeightRequest="250"
                     InitialRotation="90"  
                     MaxAngle="270"
                     MinValue="0"
                     MaxValue="100"
                     AnimationsSpeed="00:00:05.500"                      
                     PressedCommand="{Binding PressedCommand}">
                    </lvc:PieChart>

                    <StackLayout Spacing="5" HorizontalOptions="Start">
                        <Button Text="Повторить" 
                   FontSize="18" 
                   BackgroundColor="Transparent"
                   HorizontalOptions="Start"
                   ImageSource="retryall.png">
                        </Button>

                        <Button Text="Мои ошибки" 
                    ImageSource="retryerr.png"
                   FontSize="18" 
                   BackgroundColor="Transparent"
                   HorizontalOptions="Start">
                        </Button>

                        <Button Text="Избранные вопросы" 
                    ImageSource="vaworites.png"
                   FontSize="18" 
                   BackgroundColor="Transparent"
                   HorizontalOptions="Start">
                        </Button>

                        <Button Text="Долгие ответы" 
                    ImageSource="retrylong.png"
                   FontSize="18" 
                   BackgroundColor="Transparent"
                   HorizontalOptions="Start">
                        </Button>

                        <Button Text="Удалить результаты" 
                    ImageSource="del.png"
                   FontSize="18" 
                   BackgroundColor="Transparent"
                   Clicked="clearbtn_Clicked"
                   HorizontalOptions="Start">
                        </Button>
                    </StackLayout>
                </StackLayout>
            </Frame>

        </FlexLayout>
    </ScrollView>
</ContentPage>