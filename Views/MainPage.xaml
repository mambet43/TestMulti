<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:TestMulti.Models"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    x:Class="TestMulti.MainPage"
    BackgroundColor="{StaticResource BackColorB}">

    <ContentPage.Resources>
        <Style x:Key="ThemeTitleLabel" TargetType="Label">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="12,3"/>
            <Setter Property="Margin" Value="20,0,0,0"/>
            <Setter Property="HorizontalOptions" Value="Start"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <CarouselView 
            ItemsSource="{Binding Themes}"
            IndicatorView="indicator"
            Loop="False"
            HorizontalScrollBarVisibility="Never"
            VerticalOptions="Center"
            Grid.Row="0">

            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="models:Theme">
                    <Frame 
                        CornerRadius="18" 
                        BackgroundColor="{StaticResource BackColorA}" 
                        Margin="10"
                        Padding="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        WidthRequest="450">

                        <!-- Адаптивный контейнер -->
                        <FlexLayout >

                            <!-- График -->
                            <Grid RowDefinitions="Auto,*,*" 
                                  WidthRequest="400">
                                <Label 
                                    Text="{Binding Title}" 
                                    Style="{StaticResource ThemeTitleLabel}"
                                    Grid.Row="0"/>

                                <lvc:PieChart 
                                    Series="{Binding Series}" 
                                    HeightRequest="300"
                                    WidthRequest="300"
                                    Grid.Row="1"
                                    InitialRotation="90" 
                                    MaxAngle="270" 
                                    MinValue="0" 
                                    MaxValue="{Binding LengthQ}" 
                                    AnimationsSpeed="00:00:01.500"/>
                            

                            <!-- Кнопки -->
                            <StackLayout 
                                Spacing="2" 
                                Padding="10"
                                Grid.Row="2"
                                WidthRequest="400">
                                <!-- Кнопки как были -->
                                <Button 
                                    Text="{Binding LengthQ, StringFormat='[{0}] Все вопросы'}" 
                                    Style="{StaticResource ActionButton}"
                                    ImageSource="all.png" 
                                    Command="{Binding StartClickedCommand}"/>

                                <Button 
                                    Text="{Binding LengthReplay, StringFormat='[{0}] Продолжить'}" 
                                    Style="{StaticResource ActionButton}"
                                    ImageSource="play.png"
                                    Command="{Binding ReplayClickedCommand}"/>

                                <Button 
                                    Text="{Binding LengthErr, StringFormat='[{0}] Мои ошибки'}" 
                                    Style="{StaticResource ActionButton}"
                                    ImageSource="retryerr.png" 
                                    Command="{Binding MyErrorClickedCommand}"/>

                                <Button 
                                    Text="{Binding LengthVaworite, StringFormat='[{0}] Избранные вопросы'}" 
                                    Style="{StaticResource ActionButton}"
                                    ImageSource="vaworites.png" 
                                    Command="{Binding VaworiteClickedCommand}"/>

                                <Button 
                                    Text="{Binding LengthLong, StringFormat='[{0}] Долгие ответы'}" 
                                    Style="{StaticResource ActionButton}"
                                    ImageSource="retrylong.png" 
                                    Command="{Binding LongClickedCommand}"/>

                                <Button 
                                    Text="Удалить результаты" 
                                    Style="{StaticResource ActionButton}"
                                    ImageSource="del.png" 
                                    Command="{Binding DelPreferencesCommand}" 
                                    CommandParameter="{Binding FileName}"/>
                            </StackLayout>
                            </Grid>
                        </FlexLayout>
                    </Frame>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- Индикатор страниц -->
        <IndicatorView
            x:Name="indicator"
            IndicatorColor="{StaticResource Primary}"
            SelectedIndicatorColor="{StaticResource Secondary}"
            IndicatorsShape="Circle"
            HorizontalOptions="Center"
            Margin="0,10,0,20"
            IndicatorSize="10"
            Grid.Row="1"/>
    </Grid>
</ContentPage>