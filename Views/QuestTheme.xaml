<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TestMulti.Views.QuestTheme"
             Title="{Binding TitlePage}">
    
    <CollectionView ItemsSource="{Binding QuestCollection}" >
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical"/>
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <DataTemplate >
                <VerticalStackLayout>                
                    <Grid Padding="10,0,10,0" Style="{StaticResource TitleQuestBackground}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Label LineBreakMode="WordWrap"  Padding="10" Text="{Binding DisplayTitle}" FontAttributes="Bold" Style="{StaticResource TitleQuest}"  Grid.Column="0"/>
                        <ImageButton Source="nonvaworites.png" HeightRequest="50" WidthRequest="50" Grid.Column="1" Style="{StaticResource FaworiteBackground}"
                                 Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SetVaworitesCommand}"
                                 CommandParameter="{Binding}">
                            <ImageButton.Triggers>
                                <DataTrigger TargetType="ImageButton" Binding="{Binding Vaworites}" Value="true">
                                    <Setter Property="Source" Value="vaworites.png" />
                                </DataTrigger>
                            </ImageButton.Triggers>
                        </ImageButton>
                    </Grid>
                     <!--Список ответов-->
                    <StackLayout BindableLayout.ItemsSource="{Binding answers}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Label Padding="30,3,10,3"
                                       LineBreakMode="WordWrap"
                                       FontAttributes="Italic"
                                       Text="{Binding title}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding correct}"
                                                         Value="True">
                                              <Setter Property="Style" Value="{StaticResource CorrectAnswerStyle}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                </Label>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
  

</ContentPage>