<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TestMulti.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TestMulti"
    xmlns:view="clr-namespace:TestMulti.Views"
    Shell.FlyoutBehavior="Flyout"
    Shell.FlyoutWidth="230"
    Title="TestMulti">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />   
    <MenuItem Text="Электробезопасность" Clicked="OnMenuItemClickedEb"/>
    <MenuItem Text="Охрана труда" Clicked="OnMenuItemClickedOt"/>
    <MenuItem Text="Работы на высоте" Clicked="OnMenuItemClickedVis"/>
    <MenuItem Text="Избранные вопросы" Clicked="OnMenuItemClickedVaworites"/>
</Shell>
